# 1. Alles ignorieren
*

# 2. Spezifische Dateien und Ordner der Extension erlauben
!manifest.json
!background.js
!content.js
!popup.html
!popup.js
!popup.css
!gtm-ui.css
!gtm-ui.js
!gtm-ui-features.js
